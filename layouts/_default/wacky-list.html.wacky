{{ define "main" }}

<div style="max-width: 900px; margin: 0 auto; padding: 4rem 1rem; text-align: center;">

  <!-- HERO -->
  <h1 style="font-size: 3rem; font-weight: 700; margin-bottom: 0.75rem;">
    Anthology Atelier
  </h1>

  <p style="font-size: 1.5rem; opacity: 0.9; margin-bottom: 3rem;">
    Ideas. Craft. Clarity.
  </p>

  <!-- SUB-SITES -->
  <div style="text-align: left; margin: 0 auto; max-width: 700px;">

    <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;">Anthology4Tech</h2>
    <p style="margin-bottom: 2rem;">
      Technical insights, modern workflows, and clean architecture.
    </p>

    <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;">Atelier4Ideas</h2>
    <p style="margin-bottom: 2rem;">
      Creative explorations, conceptual thinking, and narrative craft.
    </p>

    <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;">ALM Mag</h2>
    <p style="margin-bottom: 3rem;">
      Long-form editorial, deep dives, and premium features.
    </p>

  </div>

</div>

<!-- FOOTER INFO -->
<div style="max-width: 900px; margin: 0 auto; padding: 2rem 1rem 4rem 1rem; text-align: left;">

  <p style="margin-bottom: 2rem;">
    Anthology Atelier curates collections of publicly shared technology content.
    Attribution, ownership, and accuracy are governed by the disclaimers on each sub-site.
    <a href="/disclaimer/">See full Disclaimer.</a>
  </p>

  <div style="display: flex; gap: 4rem; flex-wrap: wrap;">

    <div>
      <h3 style="margin-bottom: 1rem;">Legal</h3>
      <ul style="list-style: none; padding: 0;">
        <li><a href="/disclaimer/">Disclaimer</a></li>
        <li><a href="/privacy/">Privacy Notice</a></li>
        <li><a href="/attribution/">Attribution</a></li>
      </ul>
    </div>

    <div>
      <h3 style="margin-bottom: 1rem;">Explore</h3>
      <ul style="list-style: none; padding: 0;">
        <li><a href="/how-anthology-works/">How Anthology Works</a></li>
        <li><a href="/contact/">Contact the Curator</a></li>
        <li><a href="/promo/">Promo / Introduction</a></li>
      </ul>
